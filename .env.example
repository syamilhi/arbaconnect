# Environment variables example for ArbaConnect ERP (Local & Vercel Production)

# 1. Wajib diisi di Vercel Dashboard -> Project Settings -> Environment Variables:
# Gunakan string acak minimal 32 karakter untuk penandatanganan HMAC-SHA256 token sesi
ARBA_AUTH_SECRET=

# 2. Opsional: Daftar origin CORS yang diizinkan (pisahkan dengan koma jika menggunakan custom domain)
ALLOWED_ORIGINS=

# 3. Opsional: Aktifkan pembacaan header IP reverse proxy (otomatis aktif saat di-deploy di Vercel)
TRUST_PROXY=1

# 4. Sangat Direkomendasikan untuk Deploy Vercel (Persistensi Database Lintas Perangkat):
# Hubungkan Vercel KV / Upstash Redis (Free Tier) di Vercel Dashboard -> Storage
# Agar seluruh transaksi, stok, dan audit log tersimpan permanen di semua instance serverless
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatif nama variabel bawaan Upstash Redis:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
